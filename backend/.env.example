# ─────────────────────────────────────────────────────────────
# Backend environment template.
#
# Either export these variables, or copy
# src/main/resources/application.yml.example to application.yml
# (gitignored) and fill in the values directly.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL / Supabase ────────────────────────────────────
# The direct host db.<ref>.supabase.co is IPv6-ONLY. Without an IPv6
# route, use the Supavisor pooler instead (session mode, port 5432):
#   jdbc:postgresql://aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# and set the username to "postgres.<project-ref>".
# The password may contain '@'; keep it as a separate property (not in the URL).
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>

# ── Redis (Upstash / Redis Cloud) ────────────────────────────
# Credentials MUST be embedded in the URL (Spring Boot ignores the
# separate username/password properties when url is set).
# Use rediss:// if the endpoint requires TLS.
SPRING_DATA_REDIS_URL=redis://default:<REDIS_PASSWORD>@<REDIS_HOST>:<PORT>

# ── JWT ──────────────────────────────────────────────────────
# Any length works (short secrets are SHA-256 stretched to 256 bits),
# but use a long random secret in production.
JWT_SECRET=<A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS>
JWT_EXPIRATION_MS=86400000

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Rate limiting (Bucket4j sliding window) ──────────────────
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Server ───────────────────────────────────────────────────
SERVER_PORT=8080